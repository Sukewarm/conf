#!name = Plasma Heatmap Test
#!desc = 实验版 GitHub 风格 Plasma 奖励日历热力图。只读取现有 Tracker 本地数据，不写入、不上传；与现有 Dashboard 完全隔离。
#!author = ChatGPT
#!system = iOS,iPadOS,macOS
#!tag = Plasma,Heatmap,Experimental
#!type = normal

[Host]
plasma-heatmap.test = 192.0.2.1

[Script]
http-request ^http:\/\/plasma-heatmap\.test(?:\/.*)?$ script-path=https://raw.githubusercontent.com/Sukewarm/conf/plasma-heatmap-test/Script/plasma_heatmap_test.js,requires-body=false,timeout=10,tag=Plasma Heatmap Test,enable=true
