#!name = Plasma Rewards Tracker
#!desc = 抓取 Plasma One primaryCashBack 响应，统计累计奖励、Accruing、目标结算日期、Paid 和本月奖励；change 模式仅金额变化时通知。
#!author = ChatGPT
#!system = iOS,iPadOS,macOS
#!tag = Plasma,Rewards,Tracker
#!type = normal

[Argument]
notify = select,"change","always","off",tag=通知模式,desc=change=仅金额变化时通知；always=每次请求都通知；off=只记录金额变化不通知

[Script]
http-response ^https:\/\/pay-tasks\.prod\.plasma-one\.tech\/api\/v1\/user\/rewards\/primaryCashBack(?:\?.*)?$ script-path=https://raw.githubusercontent.com/Sukewarm/conf/main/Script/plasma_rewards.js,requires-body=true,binary-body-mode=false,timeout=10,tag=Plasma 奖励抓取,argument=[{notify}],enable=true
generic script-path=https://raw.githubusercontent.com/Sukewarm/conf/main/Script/plasma_rewards.js,tag=查看 Plasma 奖励,timeout=10,argument=[{notify}],enable=true

[MITM]
hostname = pay-tasks.prod.plasma-one.tech
