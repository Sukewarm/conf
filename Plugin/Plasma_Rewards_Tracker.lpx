#!name = Plasma Rewards Tracker
#!desc = 抓取 Plasma One primaryCashBack 响应，统计累计奖励、Accruing、目标结算日期、Paid、本月奖励和邀请码使用量；不修改原响应。
#!author = ChatGPT
#!system = iOS,iPadOS,macOS
#!tag = Plasma,Rewards,Tracker
#!type = normal

[Argument]
notify = select,"change","always","off",tag=通知模式,desc=change=数值变化时通知；always=每次请求都通知；off=只记录不通知
show_referral = switch,true,tag=显示邀请码,desc=通知中显示主邀请码的已用/剩余数量

[Script]
http-response ^https:\/\/pay-tasks\.prod\.plasma-one\.tech\/api\/v1\/user\/rewards\/primaryCashBack(?:\?.*)?$ script-path=https://raw.githubusercontent.com/Sukewarm/conf/main/Script/plasma_rewards.js,requires-body=true,binary-body-mode=false,timeout=10,tag=Plasma 奖励抓取,argument=[{notify},{show_referral}],enable=true
generic script-path=https://raw.githubusercontent.com/Sukewarm/conf/main/Script/plasma_rewards.js,tag=查看 Plasma 奖励,timeout=10,argument=[{notify},{show_referral}],enable=true

[MITM]
hostname = pay-tasks.prod.plasma-one.tech
