[Host]
plasma-dashboard.test = 192.0.2.1

[Script]
http-request ^http:\/\/plasma-dashboard\.test(?:\/.*)?$ script-path=https://raw.githubusercontent.com/Sukewarm/conf/main/Script/plasma_dashboard.js,requires-body=false,timeout=10,tag=Plasma Dashboard,enable=true
